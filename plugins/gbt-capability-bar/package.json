{
  "name": "gbt-potato-capability-bar-v1",
  "version": "1.0.0",
  "private": true,
  "description": "GBT小土豆V8 · 能力栏（DSH 客户端插件）：左栏脚部一格 + 浮层内嵌（零开窗）；宿主半边只给一条只读白名单路由与一份现读数据件。包名即 specifier —— 换代码要换它才能不重启换代，见 README。",
  "type": "module",
  "main": "lib/host.js",
  "exports": {
    ".": "./lib/host.js",
    "./host": "./lib/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  }
}
