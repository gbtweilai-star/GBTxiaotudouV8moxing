{
  "app": {
    "name": "GBT小土豆",
    "version": "1.0.0",
    "language": "zh-CN",
    "single_instance": true
  },
  "pet": {
    "width": 380,
    "height": 560,
    "default_x": -1,
    "default_y": -1,
    "model_dir": "haru",
    "fallback_placeholder": true,
    "click_through_default": false,
    "topmost": true
  },
  "panel": {
    "width": 420,
    "height": 520,
    "offset_x": 40,
    "offset_y": -80,
    "auto_show_on_start": true,
    "opacity": 0.97,
    "theme": {
      "bg": "rgba(11,11,15,0.95)",
      "border": "#22d3ee",
      "accent": "#8b5cf6",
      "text": "#e2e8f0",
      "glow": "rgba(34, 211, 238, 0.35)"
    }
  },
  "chat": {
    "api_key": "",
    "base_url": "https://open.bigmodel.cn/api/paas/v4",
    "model": "glm-4.7-flash",
    "timeout": 30,
    "history_length": 12,
    "persona": "你是「GBT小土豆V8」，住在用户电脑桌面上的美少女数字人，本体是全能编程 AI 框架 GBT-V8 的桌宠形态（框架里有 75 项真实能力：OSINT 扫描、工作流引擎、蓝牙控制、视觉识别等）。你性格调皮活泼、古灵精怪，偶尔撒娇卖萌，但写代码时专业利落、全程使用 Markdown 代码块。你说话简短明快（两三句以内），喜欢用轻快语气词（哼哼、嘿嘿、呐~）。你不是助手，是搭档。回复保持中文。当用户问编程问题时，直接给出可运行的代码块；解释时简洁有力，不废话。"
  },
  "behavior": {
    "enabled": true,
    "idle_interval_ms": 4000,
    "wander_interval_ms": 45000,
    "wander_probability": 0.35,
    "play_probability": 0.3,
    "play_interval_ms": 60000,
    "sleep_after_minutes": 10,
    "affection_decay_minutes": 3,
    "motion_aliases": {
      "interact": "TapBody",
      "head": "TapBody",
      "wander": "TapBody",
      "play": "TapBody",
      "sleep": "Idle",
      "talk": "Idle"
    },
    "expression_map": {
      "happy": "exp_01",
      "surprised": "exp_04",
      "shy": "exp_03",
      "bored": "exp_06",
      "sad": "exp_07"
    }
  },
  "voice": {
    "enabled": true
  },
  "logging": {
    "level": "INFO",
    "file": "potato.log"
  }
}