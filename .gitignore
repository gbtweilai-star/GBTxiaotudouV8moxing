# ===== GBT小土豆V8 .gitignore =====

# --- 敏感信息（绝不入库）---
.env
*.env
.env.*
secrets/
*_key*.json
credentials*.json

# --- Python ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/

# --- 大体积二进制库（gbt_allinone 内嵌运行时，269MB，不入库）---
gbt_allinone/.pylibs/
gbt_allinone/archived_logs/
gbt_allinone/__pycache__/

# --- 运行时数据仓（store/：助记词/账本/审计流/镜像空间，本地运行时产物，不入库）---
gbt_allinone/store/

# --- 资金模块（钱包/账本/收款桥，独立于纯全能 AI 框架分发，不入库）---
gbt_allinone/wallet/
gbt_allinone/ledger/
gbt_allinone/bridge/
gbt_allinone/adapters/wallet_adapter.py
gbt_allinone/export_statement.py
gbt_allinone/notify.py
gbt_allinone/loop.py
gbt_allinone/examples/receive_to_ledger_demo.py
gbt_allinone/examples/rpc_check.py
gbt_allinone/examples/wallet_ledger_demo.py

# --- OpenClaw / 系统目录（本机状态，不属于源码）---
.openclaw/
.autoclaw/
.opencode/
.openclaw-attachments/
agent-gvmz-gbtv8/
.cluster/*.py
archive/

# --- 媒体缓存与临时文件 ---
potato_pet/potato_state.json
*.log
*.tmp
.DS_Store
Thumbs.db
