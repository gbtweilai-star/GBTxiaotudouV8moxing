# =============================================================================
#  gbt-wallet.service — gbt_wallet API 的 systemd 单元示例 (Linux)
# -----------------------------------------------------------------------------
#  安装:
#    sudo install -d -m 0750 -o gbtwallet -g gbtwallet /var/lib/gbt-wallet
#    sudo install -d -m 0750 /etc/gbt-wallet
#    sudo cp gbt_allinone/deploy/gbt-wallet.service /etc/systemd/system/gbt-wallet.service
#    sudo cp gbt_allinone/deploy/env.example /etc/gbt-wallet/wallet.env   # 改值后:
#    sudo chown root:root /etc/gbt-wallet/wallet.env && sudo chmod 600 /etc/gbt-wallet/wallet.env
#    sudo systemctl daemon-reload && sudo systemctl enable --now gbt-wallet
#    systemctl status gbt-wallet ; journalctl -u gbt-wallet -f
#
#  说明:
#    * 端口由 EnvironmentFile 里的 GBT_WALLET_PORT 决定(api.py 默认读该变量), 故 ExecStart 不写 --port,
#      避免变量缺失时展开成空参数导致启动失败。
#    * 服务只绑 127.0.0.1; 公网入口由反向代理(Caddy/Nginx, 见 Caddyfile)提供并终止 TLS。
#    * 数据目录是唯一需要写入的路径(ReadWritePaths); 其余文件系统只读。
# =============================================================================
[Unit]
Description=GBT Wallet API (gbt_wallet 收款钱包服务, loopback only)
Documentation=file:///opt/gbt-autoclaw/gbt_allinone/deploy/DEPLOY.md
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=gbtwallet
Group=gbtwallet
WorkingDirectory=/opt/gbt-autoclaw
EnvironmentFile=/etc/gbt-wallet/wallet.env
# 若用 venv: ExecStart=/opt/gbtwallet/venv/bin/python -m gbt_wallet.api --host 127.0.0.1
ExecStart=/usr/bin/python3 -m gbt_wallet.api --host 127.0.0.1
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT
UMask=0077

# ---------- 加固(最小权限) ----------
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
# 只放开数据目录(写)与代码目录(读); 其余保持只读
ReadWritePaths=/var/lib/gbt-wallet
ReadOnlyPaths=/opt/gbt-autoclaw
# 注: 若数据根放在 /home 下, ProtectHome=read-only 会拦住写入 —— 请改用 /var/lib 或在此追加 ReadWritePaths
# 注: MemoryDenyWriteExecute=yes 可进一步收紧, 但极少数 Python C 扩展会因此启动失败; 如需请自行测试后开启

[Install]
WantedBy=multi-user.target
