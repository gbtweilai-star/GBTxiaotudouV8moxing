  "ai-orchestration": {
    "name": "ai-orchestration",
    "nodes": [
      {
        "id": "scan",
        "kind": "selfscan",
        "params": {
          "autofix": true
        }
      },
      {
        "id": "analyze",
        "kind": "llm_chat",
        "params": {
          "prompt": "你是框架质检员。体检语义说明：findings 为空数组=五维全过无任何问题；guard=护栏正常拦截次数；trace=测试足迹数；runtime=0=零运行时故障。基于此语义解读体检数据：能力数={{scan.gbt_result.result.capabilities_total}}，findings={{scan.gbt_result.result.findings}}，审计信号={{scan.gbt_result.result.sections.audit.by_signal}}。用三句话给出总体判断、最值得注意的点、改进建议。",
          "max_tokens": 300,
          "timeout": 90
        },
        "depends_on": [
          "scan"
        ]
      },
      {
        "id": "publish",
        "kind": "pipeline_submit",
        "params": {
          "name": "v8-ai-analysis-v2.txt",
          "content": "AI质检分析v2(DeepSeek): {{analyze.gbt_result.result.reply}}",
          "meta": {
            "actor": "engine-ai-orchestration",
            "purpose": "语义修正后的AI质检"
          }
        },
        "depends_on": [
          "analyze"
        ]
      }
    ],
    "defined_at": "2026-09-11T04:35:57"
  },
